# Secrets (JWT_SECRET, ADMIN_PASSWORD, EUREKA_PASSWORD, GRAFANA_ADMIN_PASSWORD) are
# not listed here: ecommerce-platform/init-secrets.sh generates them into
# ecommerce-platform/.env, and the stack refuses to start without them. Append the
# non-secret settings below to that file if you want to change them.

# ─── Grafana ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin

# ─── Tracing ─────────────────────────────────────────────────────────
# Sampling probability: 1.0 = 100% (all traces), 0.1 = 10%
TRACING_SAMPLING_PROBABILITY=1.0

# ─── AlertManager ────────────────────────────────────────────────────
# Configure alertmanager/alertmanager.yml for your notification channel
# (Slack webhook, SMTP, PagerDuty, etc.)

# ─── Application ─────────────────────────────────────────────────────
ENVIRONMENT=development
VITE_API_BASE_URL=/
