# ─── Grafana ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Tracing ─────────────────────────────────────────────────────────
# Sampling probability: 1.0 = 100% (all traces), 0.1 = 10%
TRACING_SAMPLING_PROBABILITY=1.0

# ─── AlertManager ────────────────────────────────────────────────────
# Configure alertmanager/alertmanager.yml for your notification channel
# (Slack webhook, SMTP, PagerDuty, etc.)

# ─── Application ─────────────────────────────────────────────────────
ENVIRONMENT=development
JWT_SECRET=myVerySecretJwtKeyThatIsAtLeast32CharactersLongForHS256
VITE_API_BASE_URL=/
