{
  "title": "Databases",
  "uid": "ecommerce-databases",
  "tags": ["ecommerce", "database", "postgres", "mongodb"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [{
      "name": "database",
      "type": "query",
      "datasource": "Prometheus",
      "query": "label_values(pg_up, database)",
      "multi": false,
      "includeAll": true,
      "allValue": ".*",
      "refresh": 2
    }]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Databases Up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 7 }] }
        }
      },
      "targets": [{ "expr": "(sum(pg_up) or vector(0)) + (sum(mongodb_up) or vector(0))", "legendFormat": "Up" }],
      "datasource": "Prometheus"
    },
    {
      "id": 2, "type": "stat", "title": "Total Active Connections",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sum(pg_stat_activity_count{datname=~\"$database\"})", "legendFormat": "Active connections" }],
      "datasource": "Prometheus"
    },
    {
      "id": 3, "type": "stat", "title": "Total Commits/s",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_commit{datname=~\"$database\",datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "commits/s" }],
      "datasource": "Prometheus"
    },
    {
      "id": 4, "type": "stat", "title": "Total Rollbacks/s",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      },
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_rollback{datname=~\"$database\",datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "rollbacks/s" }],
      "datasource": "Prometheus"
    },
    {
      "id": 5, "type": "stat", "title": "Cache Hit Ratio",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.99 }] }
        }
      },
      "targets": [{
        "expr": "sum(pg_stat_database_blks_hit{datname=~\"$database\",datname!~\"template.*|postgres\"}) / (sum(pg_stat_database_blks_hit{datname=~\"$database\",datname!~\"template.*|postgres\"}) + sum(pg_stat_database_blks_read{datname=~\"$database\",datname!~\"template.*|postgres\"}))",
        "legendFormat": "Cache hit %"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 6, "type": "stat", "title": "Deadlocks/s",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        }
      },
      "targets": [{ "expr": "sum(rate(pg_stat_database_deadlocks{datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "deadlocks/s" }],
      "datasource": "Prometheus"
    },
    {
      "id": 7, "type": "table", "title": "Database Health Overview",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 6 },
      "targets": [
        { "expr": "pg_up", "legendFormat": "{{database}}", "instant": true },
        { "expr": "mongodb_up", "legendFormat": "{{database}} (mongodb)", "instant": true },
        { "expr": "pg_stat_activity_count", "legendFormat": "connections", "instant": true }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 8, "type": "timeseries", "title": "Active Connections per Database",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "expr": "pg_stat_activity_count{datname!~\"template.*|postgres\"}",
        "legendFormat": "{{datname}}"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 9, "type": "timeseries", "title": "Transaction Rate per Database",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[5m])", "legendFormat": "{{datname}} commits" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[5m])", "legendFormat": "{{datname}} rollbacks" }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 10, "type": "timeseries", "title": "Row Operations (tuples fetched/inserted/updated/deleted)",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_fetched{datname=~\"$database\",datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "fetched" },
        { "expr": "sum(rate(pg_stat_database_tup_inserted{datname=~\"$database\",datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "inserted" },
        { "expr": "sum(rate(pg_stat_database_tup_updated{datname=~\"$database\",datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "updated" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted{datname=~\"$database\",datname!~\"template.*|postgres\"}[5m]))", "legendFormat": "deleted" }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 11, "type": "timeseries", "title": "HikariCP Connection Pool (per service)",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "{{application}} active" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "{{application}} idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "{{application}} pending" }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 12, "type": "row", "title": "MongoDB — catalogdb (catalog-service read model)",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13, "type": "stat", "title": "MongoDB Up",
      "gridPos": { "x": 0, "y": 27, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "mongodb_up", "legendFormat": "{{database}}" }],
      "datasource": "Prometheus"
    },
    {
      "id": 14, "type": "stat", "title": "MongoDB Connections",
      "gridPos": { "x": 4, "y": 27, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sum(mongodb_ss_connections{conn_type=\"current\"})", "legendFormat": "current" }],
      "datasource": "Prometheus"
    },
    {
      "id": 15, "type": "stat", "title": "MongoDB Ops/s",
      "gridPos": { "x": 8, "y": 27, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "targets": [{ "expr": "sum(rate(mongodb_ss_opcounters[5m]))", "legendFormat": "ops/s" }],
      "datasource": "Prometheus"
    },
    {
      "id": 16, "type": "stat", "title": "catalogdb data size",
      "gridPos": { "x": 12, "y": 27, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "expr": "sum(mongodb_dbstats_dataSize{exported_database=\"catalogdb\"})", "legendFormat": "dataSize" }],
      "datasource": "Prometheus"
    },
    {
      "id": 17, "type": "stat", "title": "MongoDB Driver Pool (catalog-service)",
      "gridPos": { "x": 16, "y": 27, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "sum(mongodb_driver_pool_checkedout{application=\"catalog-service\"})", "legendFormat": "checked out" },
        { "expr": "sum(mongodb_driver_pool_size{application=\"catalog-service\"})", "legendFormat": "pool size" }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 18, "type": "timeseries", "title": "MongoDB Operations by type",
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [{ "expr": "rate(mongodb_ss_opcounters[5m])", "legendFormat": "{{legacy_op_type}}" }],
      "datasource": "Prometheus"
    },
    {
      "id": 19, "type": "timeseries", "title": "MongoDB Connections",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "mongodb_ss_connections{conn_type=\"current\"}", "legendFormat": "current" },
        { "expr": "mongodb_ss_connections{conn_type=\"active\"}", "legendFormat": "active" }
      ],
      "datasource": "Prometheus"
    }
  ]
}
